// Esquema de la base de datos (PostgreSQL 16). Ver docs/PLAN-BACKEND.md §2.
// Cliente generado en src/generated/prisma (ignorado por git; `npm run db:generate`).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// admin: todo el panel. gestor: solo sus solicitudes asignadas y «Mi cuenta».
enum AdminRole {
  admin
  gestor
}

model AdminUser {
  id                 String      @id @default(cuid())
  email              String      @unique
  name               String
  role               AdminRole   @default(gestor)
  passwordHash       String
  active             Boolean     @default(true)
  /// Obliga a cambiar la contraseña antes de usar el panel (primer acceso o restablecimiento).
  mustChangePassword Boolean     @default(true)
  /// Gmail propio del usuario para enviar «como» su dirección corporativa (requiere «Enviar como» en Gmail).
  gmailUser          String?
  /// Contraseña de aplicación de Google, cifrada (AES-256-GCM con APP_SECRET_KEY). Nunca se devuelve.
  gmailAppPass       String?
  /// Copia oculta de cada correo que envía el usuario a su propia dirección corporativa.
  bccSelf            Boolean     @default(false)
  createdAt          DateTime    @default(now())
  lastLoginAt        DateTime?
  asignadas          Solicitud[]
  mensajesEnviados   MessageLog[]
}

model Destination {
  id         String   @id // ISO 3166-1 numérico ("392"), igual que en el front
  slug       String   @unique
  name       String
  code       String
  region     String
  lon        Float
  lat        Float
  tagline    String
  bestSeason String
  duration   String
  idealFor   String
  badge      String?
  includes   String[]
  imageSrc   String
  imageAlt   String
  featured   Boolean  @default(false)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  offers     Offer[]

  @@index([sortOrder])
}

model Offer {
  id            String      @id
  title         String
  // Slug del destino (así lo usa el front: enlace a la ficha y selector del editor).
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [slug], onUpdate: Cascade, onDelete: Restrict)
  price         String
  priceNote     String
  dates         String
  duration      String
  text          String
  includes      String[]
  imageSrc      String
  imageAlt      String
  badge         String?
  /// Promoción de portada: como mucho una (lo garantiza upsertOffer). promoText vacío = "Título · desde Precio".
  promo         Boolean     @default(false)
  promoText     String?
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)
  updatedAt     DateTime    @updatedAt

  @@index([sortOrder])
  @@index([destinationId])
}

/// Páginas del asistente y sus preguntas (FormStep completo en `data`).
model FormStep {
  id        String   @id // "viaje", "contacto"
  sortOrder Int
  data      Json
  updatedAt DateTime @updatedAt
}

/// Bloques de texto editables de SiteContent, con la misma forma que src/data/site.ts.
model SiteSetting {
  key       String   @id // "brand", "nav", "home.hero", "home.method", … "map", "contact", "offers", "footer"
  data      Json
  updatedAt DateTime @updatedAt
}

enum RequestStatus {
  nueva
  en_curso
  cerrada
}

model Solicitud {
  id        String        @id // <iso-fecha>_<8 hex>, igual que los ficheros JSON antiguos
  createdAt DateTime      @default(now())
  status    RequestStatus @default(nueva)
  notes     String?
  data      Json // SolicitudInput validado
  prompt    String // brief .txt generado con buildPrompt()
  email     String // copia desnormalizada para buscar
  phone     String
  name      String
  /// Gestor que la atiende. null = sin asignar (solo la ve el admin).
  assignedToId String?
  assignedTo   AdminUser?  @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  messages  MessageLog[]

  @@index([createdAt])
  @@index([status])
  @@index([email])
  @@index([assignedToId])
}

model Contacto {
  id        String   @id
  createdAt DateTime @default(now())
  data      Json // ContactoInput
  email     String
  handled   Boolean  @default(false)

  @@index([createdAt])
  @@index([handled])
}

/// Correos enviados desde el servidor (confirmaciones, avisos a la agencia y mensajes del gestor).
model MessageLog {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  solicitudId String?
  solicitud   Solicitud? @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  to          String
  /// Remitente usado (dirección corporativa del usuario o la de la agencia).
  from        String    @default("")
  /// Usuario del panel que lo envió; null en envíos automáticos.
  sentById    String?
  sentBy      AdminUser? @relation(fields: [sentById], references: [id], onDelete: SetNull)
  subject     String
  kind        String // "confirmacion" | "admin" | "aviso-agencia" | "aviso-gestor"
  status      String // "sent" | "error" | "skipped"
  error       String?

  @@index([solicitudId])
  @@index([createdAt])
  @@index([sentById])
}

model MediaAsset {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  path      String   @unique // "/uploads/2026/10/xxxx.webp"
  width     Int
  height    Int
  bytes     Int
  alt       String?
}
