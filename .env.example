# Copia este fichero a .env en el VPS y rellena los valores. Nunca subas .env al repositorio.

# Sitio
NEXT_PUBLIC_SITE_URL=https://turistabybonestar.com

# Base de datos (el contenedor `db` de docker-compose usa POSTGRES_*; `web` usa DATABASE_URL)
POSTGRES_USER=tbb
POSTGRES_PASSWORD=
POSTGRES_DB=turistabybonestar
DATABASE_URL=postgresql://tbb:<POSTGRES_PASSWORD>@db:5432/turistabybonestar?schema=public

# Auth.js (AUTH_SECRET: `openssl rand -base64 32`)
AUTH_SECRET=
AUTH_URL=https://turistabybonestar.com
AUTH_TRUST_HOST=true
# Contraseña inicial de los cuatro usuarios del panel (contacto@, javierestornell@, sandramartinez@,
# alexandra@). El seed no la sobrescribe en usuarios existentes; cada uno la cambia en su primer acceso.
ADMIN_SEED_PASSWORD=

# Cifrado de las contraseñas de aplicación de Gmail guardadas en la base de datos (AES-256-GCM).
# `openssl rand -base64 32`. Si se pierde, los usuarios tendrán que volver a conectar su Gmail.
APP_SECRET_KEY=

# Correo por Gmail (smtp.gmail.com:587, STARTTLS). El puerto 25 está bloqueado en el VPS.
# Cada usuario conecta su propio Gmail desde «Mi cuenta». Aquí va la cuenta de la agencia, que envía
# las confirmaciones automáticas y los avisos. Contraseña de aplicación: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
AGENCY_GMAIL_USER=
AGENCY_GMAIL_APP_PASSWORD=
# Remitente de las confirmaciones (debe estar añadido como «Enviar como» en la cuenta de la agencia)
MAIL_FROM="TuristaByBonestar <contacto@turistabybonestar.com>"
# Recibe los avisos de solicitudes y contactos
MAIL_AGENCY=contacto@turistabybonestar.com

# Archivos (uploads y copias)
DATA_DIR=/app/data
UPLOAD_MAX_MB=10
